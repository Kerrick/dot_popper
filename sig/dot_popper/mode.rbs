module DotPopper
  class Mode < ::Data
    LARGEST_SEED: Integer

    attr_reader name: Symbol

    attr_reader seed: Integer

    attr_reader date: Date?

    def self.new: (name: Symbol, seed: Integer, date: Date?) -> instance

    def self.free: (Random random) -> Mode

    def self.daily: (Date date) -> Mode

    def self.seed_for: (Date date) -> Integer

    def daily?: () -> bool

    def random: () -> Random
  end
end
