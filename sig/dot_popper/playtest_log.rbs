module DotPopper
  class PlaytestLog
    COLUMNS: Array[String]

    HEADER: String

    @archive: ^(String name) -> BestScore::_Store

    @store: BestScore::_Store

    @clock: ^() -> Time

    @today: ^() -> Date

    @recorder: GameStats::Recorder

    def initialize: (BestScore::_Store store, ?clock: ^() -> Time, ?today: ^() -> Date,
                     ?archive: ^(String name) -> BestScore::_Store) -> void

    def call: (event event) -> void

    private

    def row: (Events::GameEnded ended, GameStats stats) -> String

    def seconds: (Float value) -> String

    def append: (String line) -> void

    def current: () -> String

    def set_aside: (String old) -> void
  end
end
