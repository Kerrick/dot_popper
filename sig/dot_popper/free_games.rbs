module DotPopper
  class FreeGames
    FIRST_GAMES: Integer
    DAILY: Integer

    @store: ScoreRecord::_Store
    @today: ^() -> Date
    @entitlement: Entitlement
    @metered: bool
    @daily: Integer
    @day: Date?
    @spent: Integer
    @first_games: Integer
    @used: Integer

    attr_reader daily: Integer

    STARTING: String

    def self.metered?: (untyped env, channel: String?, offered: bool) -> bool
    def self.player?: (untyped env, channel: String?) -> bool
    def self.starting: (untyped env) -> Integer?
    def self.unlimited: () -> FreeGames
    def initialize: (ScoreRecord::_Store store, today: ^() -> Date, entitlement: Entitlement, ?metered: bool, ?first_games: Integer, ?daily: Integer) -> void
    def metered?: () -> bool
    def daily_left: () -> Integer
    def first_games_left: () -> Integer
    def left: () -> Integer
    def can_play?: () -> bool
    def spend!: () -> bool

    private

    def today: () -> Date
    def day: (String? text) -> Date?
    def count: (String? text, Integer default) -> Integer
  end
end
