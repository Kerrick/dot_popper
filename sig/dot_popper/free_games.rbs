module DotPopper
  class FreeGames
    BANK: Integer
    DAILY: Integer

    @store: ScoreRecord::_Store
    @today: ^() -> Date
    @entitlement: Entitlement
    @metered: bool
    @daily: Integer
    @day: Date?
    @spent: Integer
    @bank: Integer
    @used: Integer

    attr_reader daily: Integer

    def self.unlimited: () -> FreeGames
    def initialize: (ScoreRecord::_Store store, today: ^() -> Date, entitlement: Entitlement, ?metered: bool, ?bank: Integer, ?daily: Integer) -> void
    def metered?: () -> bool
    def daily_left: () -> Integer
    def bank_left: () -> Integer
    def left: () -> Integer
    def can_play?: () -> bool
    def spend!: () -> bool

    private

    def today: () -> Date
    def day: (String? text) -> Date?
    def count: (String? text, Integer default) -> Integer
  end
end
