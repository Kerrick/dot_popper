module DotPopper
  class AchievementWatch
    @game: Game?

    @targets: Hash[Float, TouchTarget]

    @found: Array[Achievement::id]

    @sharp: Integer

    @run: Integer

    @slipped: bool

    @low: bool

    @early: Integer

    @last_pop: Float?

    @covered: bool

    @tapped: bool

    def initialize: () -> void

    def earned: () -> Array[Achievement::id]

    def call: (event event) -> void

    private

    def reset: () -> void

    def begin_game: (Game game) -> void

    def popped: (Events::Popped event, Game game) -> void

    def penalized: (Game game) -> void

    def ended: (Events::GameEnded event) -> void

    def sharp: (Dot dot, Array[Dot] above) -> void

    def waited: (Float seconds) -> void

    def streak: () -> void

    def early: (Game game) -> void

    def clock: (Game game) -> void

    def appeared: (Dot dot, Array[Dot] above, Game game) -> void

    def target: (Float radius) -> TouchTarget

    def find: (Achievement::id id) -> void
  end
end
