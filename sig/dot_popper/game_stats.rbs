module DotPopper
  class GameStats < ::Data
    attr_reader pops: Integer

    attr_reader mistakes: Integer

    attr_reader softened: Integer

    attr_reader times_to_pop: Array[Float]

    attr_reader fresh_since: Float

    attr_reader duration: Float

    attr_reader score: Integer

    attr_reader dots_in_a_row: Integer

    attr_reader most_dots_in_a_row: Integer

    attr_reader bonuses: Integer

    def self.start: () -> GameStats

    def self.opening: (Game game) -> GameStats

    def self.new: (pops: Integer, mistakes: Integer, softened: Integer, times_to_pop: Array[Float], fresh_since: number, duration: number, ?score: Integer, ?dots_in_a_row: Integer, ?most_dots_in_a_row: Integer, ?bonuses: Integer) -> instance

    def initialize: (pops: Integer, mistakes: Integer, softened: Integer, times_to_pop: Array[Float], fresh_since: number, duration: number, ?score: Integer, ?dots_in_a_row: Integer, ?most_dots_in_a_row: Integer, ?bonuses: Integer) -> void

    def record: (event event, at: Float) -> GameStats

    def longest_time_to_pop: () -> Float

    def shortest_time_to_pop: () -> Float?

    def mean_time_to_pop: () -> Float

    def pops_within: (number seconds) -> Integer

    private

    def popped: (Events::Popped event, Float at) -> GameStats

    public

    class Recorder
      attr_reader stats: GameStats

      @game: Game?

      def initialize: () -> void

      def call: (event event) -> void
    end
  end
end
