module DotPopper
  class Entitlement
    FORCED_BY: String
    DESKTOP_PRO: bool
    STORE_SYSTEMS: Array[String]

    @forced: bool
    @license: _License?
    @trust: Receipt::Trust
    @proven: bool
    @refused: String?

    interface _License
      def pro?: () -> bool
    end

    def self.free: () -> Entitlement
    def self.test: () -> Entitlement
    def self.forced?: (untyped env, ?os: String?) -> bool
    def initialize: (?forced: bool, ?license: _License?, ?trust: Receipt::Trust) -> void
    def pro?: () -> bool
    def prove: (String? receipt) -> bool
  end
end
