module DotPopper
  class Entitlement
    PRO: String
    FORCED_BY: String
    DESKTOP_PRO: bool
    STORE_SYSTEMS: Array[String]


    @store: ScoreRecord::_Store
    @forced: bool
    @license: _License?

    interface _License
      def pro?: () -> bool
    end

    def self.free: () -> Entitlement
    def self.forced?: (untyped env, ?os: String?) -> bool
    def initialize: (ScoreRecord::_Store store, ?forced: bool, ?license: _License?) -> void
    def pro?: () -> bool
    def unlock!: () -> untyped
  end
end
