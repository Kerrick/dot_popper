module DotPopper
  class Achievements
    @store: BestScore::_Store

    @days: Hash[Achievement::id, String]

    def initialize: (BestScore::_Store store) -> void

    def earned?: (Achievement::id id) -> bool

    def earned: () -> Array[Achievement::id]

    def count: () -> Integer

    def day: (Achievement::id id) -> String?

    def award: (Array[Achievement::id] ids, day: String) -> Array[Achievement::id]

    def saved: () -> String?

    def clear: () -> void

    def restore: (String? text) -> void

    private

    def text: () -> String

    def parse: (String? text) -> Hash[Achievement::id, String]
  end
end
