module DotPopper
  class LifetimeStats < ::Data
    RECENT: Integer

    DAY: Regexp

    UNKNOWN: String

    attr_reader games: Integer

    attr_reader pops: Integer

    attr_reader slips: Integer

    attr_reader seconds: Float

    attr_reader days: Integer

    attr_reader last_day: String?

    attr_reader recent: Array[Integer]

    attr_reader recent_classes: Array[SizeClass?]

    attr_reader streak: GoalStreak

    attr_reader bests: Hash[SizeClass, Bests]

    def self.new: (?games: Integer, ?pops: Integer, ?slips: Integer, ?seconds: number, ?days: Integer, ?last_day: String?,
                   ?recent: Array[Integer], ?recent_classes: Array[SizeClass?], ?streak: GoalStreak,
                   ?bests: Hash[SizeClass, Bests]) -> instance

    def initialize: (?games: Integer, ?pops: Integer, ?slips: Integer, ?seconds: number, ?days: Integer, ?last_day: String?,
                     ?recent: Array[Integer], ?recent_classes: Array[SizeClass?], ?streak: GoalStreak,
                     ?bests: Hash[SizeClass, Bests]) -> void

    def self.parse: (String? text, ?legacy: SizeClass) -> LifetimeStats

    def self.old?: (String? text) -> bool

    def bests_in: (SizeClass size_class) -> Bests

    def add: (GameStats stats, day: String, size_class: SizeClass) -> LifetimeStats

    def records_set_by: (GameStats stats, SizeClass size_class) -> Array[Record]

    def to_text: () -> String

    class Bests < ::Data
      attr_reader games: Integer

      attr_reader longest_game: Float

      attr_reader longest_run: Integer

      attr_reader fastest_pop: Float?

      attr_reader longest_wait: Float

      def self.new: (?games: Integer, ?longest_game: number, ?longest_run: Integer, ?fastest_pop: number?,
                     ?longest_wait: number) -> instance

      def initialize: (?games: Integer, ?longest_game: number, ?longest_run: Integer, ?fastest_pop: number?,
                       ?longest_wait: number) -> void

      def self.parse: (Pairs pairs) -> Bests

      def add: (GameStats stats) -> Bests

      def records_set_by: (GameStats stats) -> Array[Record]

      def pairs: () -> Array[[String, number?]]

      private

      def beats?: (number value, number best, Integer digits) -> bool

      def faster: (Float? pop) -> Record?
    end

    class Record < ::Data
      ORDER: Array[Symbol]

      attr_reader kind: Symbol

      attr_reader value: number

      def self.new: (kind: Symbol, value: number) -> instance
    end

    class Pairs < ::Data
      attr_reader values: Hash[String, String]

      def self.new: (values: Hash[String, String]) -> instance

      def self.parse: (String? text) -> Pairs

      def count: (Symbol key) -> Integer

      def time: (Symbol key) -> Float?

      def counts: (Symbol key) -> Array[Integer]

      def classes: (Symbol key) -> Array[SizeClass?]

      def day: (Symbol key) -> String?

      def within: (String prefix) -> Pairs

      private

      def natural: (String? text) -> Integer?
    end
  end
end
