module DotPopper
  class Game
    LARGEST_SEED: Integer

    interface _Listener
      def call: (event event) -> void
    end

    type state = Title | Playing | GameOver

    attr_reader state: state

    attr_reader best: BestScore

    attr_reader screen: Field

    attr_reader sizing: DotSizing

    @random: Random

    @listeners: Array[_Listener]

    def initialize: (Field screen, ?best: BestScore, ?random: Random, ?sizing: DotSizing) -> void

    def subscribe: (?_Listener? listener) ?{ (event event) -> void } -> self

    def press: (number x, number y) -> self

    def update: (number seconds) -> self

    def round: () -> Round?

    def field: () -> Field

    def size_class: () -> SizeClass

    def screen=: (Field screen) -> void

    def sizing=: (DotSizing sizing) -> void

    def announce: [E < event] (E? event) -> E?

    def show_title: () -> Title

    def start_round: (?Integer seed) -> Playing

    def resume: (field: Field, dots: Stack, score: Integer, seconds: number) -> self

    def finish: (Round round, Integer seed, SizeClass size_class) -> GameOver

    private

    def begin_round: (Round round, Integer seed) -> Playing

    def advance: (state next_state) -> self

    class Title < ::Data
      def self.new: () -> instance

      def round: () -> nil

      def press: (Game game, number x, number y) -> Playing

      def update: (Game game, number seconds) -> Title
    end

    class Playing < ::Data
      attr_reader round: Round

      attr_reader seed: Integer

      attr_reader size_class: SizeClass

      def self.new: (round: Round, seed: Integer, size_class: SizeClass) -> instance

      def press: (Game game, number x, number y) -> (Playing | GameOver)

      def update: (Game game, number seconds) -> (Playing | GameOver)

      private

      def settle: (Game game) -> (Playing | GameOver)
    end

    class GameOver < ::Data
      attr_reader round: Round

      attr_reader new_best: bool

      attr_reader shown: Float

      def self.new: (round: Round, new_best: bool, ?shown: Float) -> instance

      def initialize: (round: Round, new_best: bool, ?shown: Float) -> void

      def score: () -> Integer

      def ready?: () -> bool

      def press: (Game game, number x, number y) -> (GameOver | Title)

      def update: (Game game, number seconds) -> GameOver
    end
  end
end
