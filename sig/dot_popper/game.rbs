module DotPopper
  class Game
    attr_reader field: Field

    attr_reader dots: Stack

    attr_reader score: Integer

    attr_reader countdown: Countdown

    # Seconds of play so far.
    attr_reader elapsed: Float

    # Every dot spawned this game, oldest first, with how it was drawn.
    attr_reader spawns: Array[Spawn]

    # Dots in a row toward the next bonus dot.
    attr_reader dots_in_a_row: Integer

    # The dots_in_a_row's reward, or nil when the game has none.
    attr_reader bonus: Rules::Bonus?

    @random: Random

    @spawner: Spawner

    @next_id: Integer

    def self.resume: (Field field, dots: Stack, score: Integer, seconds: number, ?random: Random, ?spawn_tries: Integer, ?bonus: Rules::Bonus?) -> Game

    def initialize: (Field field, ?random: Random, ?dots: Stack?, ?score: Integer, ?seconds: number, ?spawn_tries: Integer, ?bonus: Rules::Bonus?) -> void

    def over?: () -> bool

    def update: (number seconds) -> void

    def tap_at: (number x, number y) -> tap_event?

    def field=: (Field field) -> void

    private

    def spawn: (Stack above, ?bonus: bool) -> Dot

    def payoff: (Dot dot) -> [Integer, Float]

    def count_toward_bonus: (Dot dot) -> bool

    def pop: (Dot dot, number x, number y) -> Events::Popped

    def penalize: (Dot dot, number x, number y) -> Events::Penalized
  end
end
