module DotPopper
  class StatsKeeper
    interface _Kept
      def saved: () -> String?

      def clear: () -> void

      def restore: (String? text) -> void
    end

    type folder = ^(String name) -> ScoreRecord::_Removable

    NOTE: String

    BACKUP: Regexp

    @kept: Hash[String, _Kept]

    @folder: folder | Folder

    @clock: ^() -> Time

    @cleared: bool

    def initialize: (score_record: _Kept, stats_book: _Kept, ?achievements: _Kept?, ?folder: folder | Folder, ?clock: ^() -> Time) -> void

    def cleared?: () -> bool

    def clear: () -> Cleared

    def restore: (Cleared cleared) -> void

    class Cleared < ::Data
      attr_reader texts: Hash[String, String?]

      def self.new: (texts: Hash[String, String?]) -> instance
    end

    class Folder
      @stores: Hash[String, ScoreRecord::Memory]

      def initialize: () -> void

      def call: (String name) -> ScoreRecord::Memory
    end

    private

    def back_up: (Hash[String, String?] texts) -> void
  end
end
