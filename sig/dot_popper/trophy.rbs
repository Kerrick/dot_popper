module DotPopper
  class Trophy
    FALL_PER_DAY: Integer
    LOWEST_STANDING: Integer
    SECONDS_A_DAY: Integer

    attr_reader holder: untyped
    attr_reader score: Integer
    attr_reader day: Integer

    def self.new: (holder: untyped, score: Integer, day: Integer) -> Trophy
    def self.vacant: () -> Trophy
    def self.day: (untyped time) -> Integer
    def self.counts?: (sized_to_screen: untyped) -> bool

    def with: (?holder: untyped, ?score: Integer, ?day: Integer) -> Trophy
    def vacant?: () -> bool
    def days_held: (Integer today) -> Integer
    def standing: (Integer today) -> Integer
    def beaten_by?: (untyped player, Integer points, Integer today) -> bool
    def taken_by: (untyped player, Integer points, Integer today) -> Trophy
  end
end
