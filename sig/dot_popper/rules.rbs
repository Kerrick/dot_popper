module DotPopper
  module Rules
    RADIUS: Integer

    SPEEDS: Array[Float]

    STARTING_SECONDS: Float

    POP_POINTS: Integer

    POP_SECONDS: Float

    PENALTY_POINTS: Integer

    PENALTY_SECONDS: Float

    LOWEST_SCORE: Integer

    class Bonus < ::Data
      attr_reader streak: Integer

      attr_reader points: Integer

      attr_reader seconds: Float

      def self.new: (streak: Integer, points: Integer, seconds: Float) -> instance
                  | (Integer streak, Integer points, Float seconds) -> instance
    end

    BONUS: Bonus

    TOUCH_TARGET: Integer

    SPAWN_LOOKAHEAD: Float

    SPAWN_TRIES: Integer

    LONGEST_FRAME: Float

    GAME_OVER_GRACE: Float

    SMALL_FIELD_BELOW: Integer

    LARGE_FIELD_FROM: Integer

    FITTED_AREA: Integer

    SMALLEST_FITTED_RADIUS: Integer

    LARGEST_FITTED_SHARE: Float
  end
end
