module DotPopper
  class Stats < ::Data
    RECENT: Integer

    DAY: Regexp

    UNKNOWN: String

    attr_reader games: Integer

    attr_reader dots_popped: Integer

    attr_reader mistakes: Integer

    attr_reader seconds: Float

    attr_reader days: Integer

    attr_reader last_day: String?

    attr_reader recent: Array[Integer]

    attr_reader recent_classes: Array[SizeClass?]

    attr_reader streak: GoalStreak

    attr_reader records: Hash[SizeClass, Records]

    def self.new: (?games: Integer, ?dots_popped: Integer, ?mistakes: Integer, ?seconds: number, ?days: Integer, ?last_day: String?,
                   ?recent: Array[Integer], ?recent_classes: Array[SizeClass?], ?streak: GoalStreak,
                   ?records: Hash[SizeClass, Records]) -> instance

    def initialize: (?games: Integer, ?dots_popped: Integer, ?mistakes: Integer, ?seconds: number, ?days: Integer, ?last_day: String?,
                     ?recent: Array[Integer], ?recent_classes: Array[SizeClass?], ?streak: GoalStreak,
                     ?records: Hash[SizeClass, Records]) -> void

    def self.parse: (String? text, ?legacy: SizeClass) -> Stats

    def self.old?: (String? text) -> bool

    def records_in: (SizeClass size_class) -> Records

    def add: (GameStats stats, day: String, size_class: SizeClass) -> Stats

    def records_set_by: (GameStats stats, SizeClass size_class) -> Array[Record]

    def to_text: () -> String

    class Records < ::Data
      attr_reader games: Integer

      attr_reader longest_game: Float

      attr_reader most_dots_in_a_row: Integer

      attr_reader shortest_time_to_pop: Float?

      attr_reader longest_time_to_pop: Float

      def self.new: (?games: Integer, ?longest_game: number, ?most_dots_in_a_row: Integer, ?shortest_time_to_pop: number?,
                     ?longest_time_to_pop: number) -> instance

      def initialize: (?games: Integer, ?longest_game: number, ?most_dots_in_a_row: Integer, ?shortest_time_to_pop: number?,
                       ?longest_time_to_pop: number) -> void

      def self.parse: (Pairs pairs) -> Records

      def add: (GameStats stats) -> Records

      def records_set_by: (GameStats stats) -> Array[Record]

      def pairs: () -> Array[[String, number?]]

      private

      def beats?: (number value, number score_record, Integer digits) -> bool

      def faster: (Float? pop) -> Record?
    end

    class Record < ::Data
      ORDER: Array[Symbol]

      attr_reader kind: Symbol

      attr_reader value: number

      def self.new: (kind: Symbol, value: number) -> instance
    end

    class Pairs < ::Data
      attr_reader values: Hash[String, String]

      def self.new: (values: Hash[String, String]) -> instance

      def self.parse: (String? text) -> Pairs

      def count: (Symbol key) -> Integer

      def time: (Symbol key) -> Float?

      def counts: (Symbol key) -> Array[Integer]

      def classes: (Symbol key) -> Array[SizeClass?]

      def day: (Symbol key) -> String?

      def within: (String prefix) -> Pairs

      private

      def natural: (String? text) -> Integer?
    end
  end
end
