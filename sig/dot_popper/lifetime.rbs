module DotPopper
  class Lifetime
    attr_reader stats: LifetimeStats

    @store: BestScore::_Store

    @today: ^() -> Date

    def initialize: (BestScore::_Store store, ?today: ^() -> Date, ?legacy: SizeClass) -> void

    def record: (RoundStats round, SizeClass size_class) -> Result

    def today: () -> Date

    def goal: () -> DailyGoal

    def goal_done?: () -> bool

    def streak: () -> Integer

    class Result < ::Data
      attr_reader records: Array[LifetimeStats::Record]

      attr_reader goal_met: bool

      def self.new: (records: Array[LifetimeStats::Record], goal_met: bool) -> instance
    end
  end
end
