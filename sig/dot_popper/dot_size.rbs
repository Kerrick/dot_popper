module DotPopper
  class DotSize < ::Data
    TOUCH_SYSTEMS: Array[String]

    attr_reader radius: number

    attr_reader reason: String

    def self.new: (radius: number, reason: String) -> instance

    def initialize: (radius: number, reason: String) -> void

    def self.for: (String os) -> DotSize

    def self.fitted: (number width, number height) -> DotSize

    def self.touch?: (String os) -> bool

    def field: (number width, number height) -> Field
  end
end
