module DotPopper
  type event = Events::Popped | Events::Penalized | Events::Missed
             | Events::GameStarted | Events::GameEnded | Events::TitleShown

  type tap_event = Events::Popped | Events::Penalized | Events::Missed

  module Events
    class Popped < ::Data
      attr_reader dot: Dot

      attr_reader x: number

      attr_reader y: number

      attr_reader points: Integer

      attr_reader seconds: Float

      attr_reader spawned: Dot

      def self.new: (dot: Dot, x: number, y: number, points: Integer, seconds: Float, spawned: Dot) -> instance
    end

    class Penalized < ::Data
      attr_reader dot: Dot

      attr_reader x: number

      attr_reader y: number

      attr_reader points: Integer

      attr_reader seconds: Float

      def self.new: (dot: Dot, x: number, y: number, points: Integer, seconds: Float) -> instance

      def softened?: () -> bool
    end

    class Missed < ::Data
      attr_reader x: number

      attr_reader y: number

      def self.new: (x: number, y: number) -> instance
    end

    class GameStarted < ::Data
      attr_reader game: Game

      attr_reader seed: Integer

      def self.new: (game: Game, seed: Integer) -> instance
    end

    class GameEnded < ::Data
      attr_reader game: Game

      attr_reader score_record: Integer

      attr_reader new_score_record: bool

      attr_reader seed: Integer

      attr_reader size_class: SizeClass

      attr_reader first: bool

      def self.new: (game: Game, score_record: Integer, new_score_record: bool, seed: Integer, size_class: SizeClass, ?first: bool) -> instance

      def initialize: (game: Game, score_record: Integer, new_score_record: bool, seed: Integer, size_class: SizeClass, ?first: bool) -> void

      def score: () -> Integer
    end

    class TitleShown < ::Data
      attr_reader score_record: Integer

      def self.new: (score_record: Integer) -> instance
    end
  end
end
