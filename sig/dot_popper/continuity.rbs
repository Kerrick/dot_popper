module DotPopper
  module Continuity
    # A check left setdef gone (Gone#heard).
    class SetdefGone < ::Data
      attr_reader since: Date

      attr_reader today: Date

      def self.new: (since: Date, today: Date) -> instance

      def days: () -> Integer
    end

    # Whether setdef is gone (watch.rb); what the typed core asks of it.
    class Gone
      def gone?: () -> bool

      def days: (Date today) -> Integer
    end

    # setdef's server answered (Gone#heard).
    class SetdefHere < ::Data
      def self.new: () -> instance
    end

    # The throwaway keys whose private seeds ship for the test build's
    # fakes (the rest of Continuity is not typed yet).
    module TestKeys
      LICENSE: String
    end

    class LicenseKey
      def self.issue: (String seed) -> LicenseKey

      def text: () -> String
    end
  end
end
