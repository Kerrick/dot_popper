module DotPopper
  class Cabinet
    LARGEST_SEED: Integer

    interface _Listener
      def call: (event event) -> void
    end

    type state = Title | Playing | GameOver

    attr_reader state: state

    attr_reader score_record: ScoreRecord

    attr_reader screen: Field

    attr_reader sizing: DotSizing

    @random: Random

    @listeners: Array[_Listener]

    def initialize: (Field screen, ?score_record: ScoreRecord, ?random: Random, ?sizing: DotSizing) -> void

    def subscribe: (?_Listener? listener) ?{ (event event) -> void } -> self

    def press: (number x, number y) -> self

    def update: (number seconds) -> self

    def game: () -> Game?

    def field: () -> Field

    def size_class: () -> SizeClass

    def screen=: (Field screen) -> void

    def sizing=: (DotSizing sizing) -> void

    def announce: [E < event] (E? event) -> E?

    def show_title: () -> Title

    def start_game: (?Integer seed) -> Playing

    def resume: (field: Field, dots: Stack, score: Integer, seconds: number) -> self

    def finish: (Game game, Integer seed, SizeClass size_class) -> GameOver

    private

    def begin_game: (Game game, Integer seed) -> Playing

    def advance: (state next_state) -> self

    class Title < ::Data
      def self.new: () -> instance

      def game: () -> nil

      def press: (Cabinet cabinet, number x, number y) -> Playing

      def update: (Cabinet cabinet, number seconds) -> Title
    end

    class Playing < ::Data
      attr_reader game: Game

      attr_reader seed: Integer

      attr_reader size_class: SizeClass

      def self.new: (game: Game, seed: Integer, size_class: SizeClass) -> instance

      def press: (Cabinet cabinet, number x, number y) -> (Playing | GameOver)

      def update: (Cabinet cabinet, number seconds) -> (Playing | GameOver)

      private

      def settle: (Cabinet cabinet) -> (Playing | GameOver)
    end

    class GameOver < ::Data
      attr_reader game: Game

      attr_reader new_score_record: bool

      attr_reader shown: Float

      def self.new: (game: Game, new_score_record: bool, ?shown: Float) -> instance

      def initialize: (game: Game, new_score_record: bool, ?shown: Float) -> void

      def score: () -> Integer

      def ready?: () -> bool

      def press: (Cabinet cabinet, number x, number y) -> (GameOver | Title)

      def update: (Cabinet cabinet, number seconds) -> GameOver
    end
  end
end
