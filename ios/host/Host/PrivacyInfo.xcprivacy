<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-FileCopyrightText: 2026 setdef <kerrick@setdef.com>
  SPDX-License-Identifier: LicenseRef-setdef-all-rights-reserved

  Dot Popper's privacy manifest, which the App Store asks of every app
  (doc/ios.md). It is in the host's Host folder, which project.yml takes
  as the target's sources, so Xcode bundles it at the app's top level.
  The game tracks no one and collects no data. The APIs with required
  reasons below (FileTimestamp C617.1, SystemBootTime 35F9.1) are the two
  that Lota's audit of what the iOS app links (LÖVE, SDL, the prebuilt
  libraries, Lota's host, Fledge's runtime) found, and the two that
  Fledge's template declares. This file replaces Fledge's whole, so it
  keeps both. App Store Connect's validation is the final authority
  (doc/publishing.md).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
