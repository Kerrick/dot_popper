#!/usr/bin/env ruby
# frozen_string_literal: true

# For answering reports, from the server's own machine:
#
#   DOT_POPPER_DB=groups.sqlite3 bin/moderate           lists unhandled reports
#   DOT_POPPER_DB=groups.sqlite3 bin/moderate hide 12   hides player 12's name
#   DOT_POPPER_DB=groups.sqlite3 bin/moderate keep 12   keeps it, closing the reports
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "dot_popper_server"

store = DotPopperServer::Store.new(ENV.fetch("DOT_POPPER_DB", "groups.sqlite3"))
case ARGV
in ["hide", id] then store.handle_report(Integer(id), hide: true)
in ["keep", id] then store.handle_report(Integer(id), hide: false)
in [] then store.reports.each { puts "#{it["reported_id"]}\t#{it["reports"]} report(s)\t#{it["name"]}" }
else abort "usage: moderate [hide ID | keep ID]"
end
