<?xml version="1.0" encoding="utf-8"?>
<!--
  Dot Popper's Android manifest (experimental; PACKAGING.md, "The Android
  kit"), which fledge build android lays over its own. It is Lota's spike
  manifest (setdef/Lota spike/android/host/android at 84c0eda): Fledge's
  manifest (lib/fledge/templates/android at v0.5.0) with what
  love-android's asks of the system for LÖVE's engine: OpenGL ES 3.0,
  vibration, a full screen with no title bar, and no restart of the
  activity when the screen turns.

  Dot Popper decides what Back does itself, as Escape (Shell::App), so the
  meta-data below asks SDL to trap Back. Without it, SDL lets Back through
  after sending Escape, and Android closes the app at once. MainActivity
  also takes predictive back on API 33 and newer when it is set.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:glEsVersion="0x00030000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="@string/app_name"@@ICON@@>
        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" android:value="1" />
        <activity
            android:name="org.setdef.fledge.host.MainActivity"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:launchMode="singleInstance"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
