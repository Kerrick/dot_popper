# The Android kit's program (experimental; PACKAGING.md, "The Android
# kit"), from Lota's spike (setdef/Lota spike/android/android_kit at
# 84c0eda). android.yml makes it the phone project's main.rb, beside the
# game's copy in game/dot_popper (Lota's doc/guide/phones.md), and it runs
# that copy's bin/dot_popper unchanged. Only with
# DOT_POPPER_KIT_PROBE=1, which the emulator runs pass as an intent extra
# and a launch from the launcher never has, it also logs what Lota's
# window reports on frames 60 and 600, each touch and key the game
# receives (with the state it arrives in), each event the game announces,
# the frame the setdef splash is over on (a key before then only skips
# the splash), and, every 15 frames of a game, where its topmost bright
# dot is.
if ENV["DOT_POPPER_KIT_PROBE"] == "1"
  $stdout.sync = true
  require "lota"
  class << Lota
    def singleton_method_added(name)
      super
      kit_wrap_draw if name == :draw && !@kit_draw
      kit_wrap_touch if name == :touchpressed && !@kit_touch
      kit_wrap_load if name == :load && !@kit_load
      kit_wrap_key if name == :keypressed && !@kit_key
    end

    def kit_wrap_key
      @kit_key = true
      key = method(:keypressed)
      define_singleton_method(:keypressed) do |*arguments|
        state = @kit_game&.state
        puts "kit probe: keypressed #{arguments.map(&:inspect).join(', ')} in #{state&.class&.name&.split('::')&.last}"
        key.call(*(key.arity.negative? ? arguments : arguments.first(key.arity)))
      end
    end

    def kit_wrap_load
      @kit_load = true
      load = method(:load)
      define_singleton_method(:load) do
        load.call
        begin
          cabinet = @app.instance_variable_get(:@cabinet)
          cabinet.subscribe { |event| puts "kit probe: event #{event.class.name.split('::').last}" }
          @kit_game = cabinet
          puts "kit probe: subscribed to the cabinet's events"
        rescue Exception => error # rubocop:disable Lint/RescueException
          puts "kit probe: error #{error.class}: #{error.message} at #{error.backtrace&.first}"
          raise
        end
      end
    end

    def kit_wrap_touch
      @kit_touch = true
      touch = method(:touchpressed)
      define_singleton_method(:touchpressed) do |*arguments|
        puts "kit probe: touchpressed #{arguments.map(&:inspect).join(', ')}"
        touch.call(*(touch.arity.negative? ? arguments : arguments.first(touch.arity)))
      end
    end

    def kit_wrap_draw
      @kit_draw = true
      draw = method(:draw)
      frames = 0
      define_singleton_method(:draw) do
        draw.call
        frames += 1
        if !@kit_splash_over && @app.instance_variable_get(:@splash).nil?
          @kit_splash_over = true
          puts "kit probe: splash over by frame #{frames}"
        end
        if [60, 600].include?(frames)
          puts "kit probe: frame #{frames}, Window.fullscreen #{Lota::Window.fullscreen.inspect}, " \
            "safe_area #{Lota::Window.safe_area.inspect}, Graphics.dimensions #{Lota::Graphics.dimensions.inspect}, " \
            "pixel_dimensions #{Lota::Graphics.pixel_dimensions.inspect}, dpi_scale #{Lota::Graphics.dpi_scale}, " \
            "System.os #{Lota::System.os.inspect}, renderer #{Lota::Graphics.renderer_info.inspect}"
        end
        state = @kit_game&.state
        if (frames % 15).zero? && state.respond_to?(:game) && state.class.name.end_with?("Playing")
          dot = state.game.dots.find(&:bright?)
          width, height = Lota::Graphics.dimensions
          puts "kit probe: dot at #{dot.x.round(1)}, #{dot.y.round(1)} in #{width}x#{height}, score #{state.game.score}" if dot
        end
      end
    end
  end
end

load File.join(__dir__, "game", "dot_popper", "bin", "dot_popper")
